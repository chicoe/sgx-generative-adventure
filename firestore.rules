rules_version = '2';

// Content model (see SPEC §4.6):
//   builds/*  + config/current  -> published; world-readable; only editors may
//                                  create a new (immutable) build / flip config
//   draft/*                     -> editor working copies, gated by the allowlist
//   saves/*                     -> per-session player state (no player accounts)
service cloud.firestore {
  match /databases/{database}/documents {

    function isEditor() {
      // ANY signed-in user is an editor. This is safe ONLY because accounts are
      // created exclusively by the admin in the Firebase console — self-service
      // sign-up MUST stay disabled (Authentication → Settings → User actions →
      // untick "Enable create"), otherwise anyone could register themselves an
      // editor account with the public API key.
      return request.auth != null;
    }

    // Published builds: world-readable. Editors may CREATE new snapshots; build
    // CONTENT is immutable (a publish can never mutate history) — only the
    // human-facing commit `message` may be edited after the fact.
    match /builds/{buildId} {
      allow read: if true;
      allow create: if isEditor();
      allow update: if isEditor()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['message']);
      allow delete: if false;
    }
    // The live pointer: world-readable; editors flip it on publish/rollback.
    match /config/{document} {
      allow read: if true;
      allow write: if isEditor();
    }

    // Editor draft content.
    match /draft/{document=**} {
      allow read, write: if isEditor();
    }

    // Player saves, keyed by an anonymous session id held in localStorage.
    // Single-player kiosk; no accounts. Tighten with App Check before any
    // public deployment.
    match /saves/{sessionId} {
      allow read, write: if true;
    }

    // Access codes gate the public game. Editors manage them; players (no auth)
    // may look up ONE code they know and spend exactly one life — nothing else.
    match /accessCodes/{code} {
      allow get: if true;            // a visitor can check a code they were given
      allow list: if isEditor();     // …but only editors can enumerate all codes
      allow create, delete: if isEditor();
      // Editors may edit freely; the public may ONLY decrement lives by one (the
      // "consume", and only while lives remain) — no other field may change.
      allow update: if isEditor()
        || (
          resource.data.lives > 0
          && request.resource.data.lives == resource.data.lives - 1
          && request.resource.data.code == resource.data.code
          && request.resource.data.livesTotal == resource.data.livesTotal
          && request.resource.data.createdAt == resource.data.createdAt
        );
    }

    // Room-entry stats: one counter doc per scene. Editors read/reset; players
    // (no auth) may ONLY create a counter at 1 or bump an existing one by exactly
    // one — no other field, no arbitrary values.
    match /roomStats/{sceneId} {
      allow read, delete: if isEditor();
      allow create: if request.resource.data.keys().hasOnly(['sceneId', 'count'])
        && request.resource.data.sceneId == sceneId
        && request.resource.data.count == 1;
      allow update: if request.resource.data.keys().hasOnly(['sceneId', 'count'])
        && request.resource.data.sceneId == sceneId
        && request.resource.data.count == resource.data.count + 1;
    }

    // Per-(code, ending) tally: one counter doc per access code + ending scene.
    // Same public contract as roomStats — create at 1, or bump by exactly one,
    // with the code/sceneId fields unchanged.
    match /endingStats/{id} {
      allow read, delete: if isEditor();
      allow create: if request.resource.data.keys().hasOnly(['code', 'sceneId', 'count'])
        && request.resource.data.count == 1;
      allow update: if request.resource.data.keys().hasOnly(['code', 'sceneId', 'count'])
        && request.resource.data.count == resource.data.count + 1
        && request.resource.data.code == resource.data.code
        && request.resource.data.sceneId == resource.data.sceneId;
    }

    // Deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
