rules_version = '2';

// Content model (see SPEC §4.6):
//   builds/*  + config/current  -> published; world-readable; only editors may
//                                  create a new (immutable) build / flip config
//   draft/*                     -> editor working copies, gated by the allowlist
//   saves/*                     -> per-session player state (no player accounts)
service cloud.firestore {
  match /databases/{database}/documents {

    function isEditor() {
      // Mirror EDITOR_ALLOWED_EMAILS. Email/Password users created in the console
      // are not email_verified, so we don't require it here.
      return request.auth != null
        && request.auth.token.email in [
          'francisco@incomputable.io'
        ];
    }

    // Published builds: world-readable. Editors may CREATE new snapshots; builds
    // are immutable (no update/delete), so a publish can never mutate history.
    match /builds/{buildId} {
      allow read: if true;
      allow create: if isEditor();
      allow update, delete: if false;
    }
    // The live pointer: world-readable; editors flip it on publish/rollback.
    match /config/{document} {
      allow read: if true;
      allow write: if isEditor();
    }

    // Editor draft content.
    match /draft/{document=**} {
      allow read, write: if isEditor();
    }

    // Player saves, keyed by an anonymous session id held in localStorage.
    // Single-player kiosk; no accounts. Tighten with App Check before any
    // public deployment.
    match /saves/{sessionId} {
      allow read, write: if true;
    }

    // Deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
