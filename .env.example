# Server-only. The Gemini key must never reach the client bundle.
GEMINI_API_KEY=
# Overridable model id. gemini-2.5-flash-lite is the cheap/fast tier with a free
# quota (gemini-2.0-flash-lite was shut down 2026-06-01).
GEMINI_MODEL=gemini-2.5-flash-lite

# Which Gemini backend the server uses (auto-detected if unset):
#   developer = Gemini Developer API — needs GEMINI_API_KEY; has a free tier
#   vertex    = Vertex AI via Application Default Credentials — no API key,
#               automatic on Firebase App Hosting; needs a GCP project + billing
# GEMINI_BACKEND=developer
# Vertex backend only (local dev: run `gcloud auth application-default login`):
# GOOGLE_CLOUD_PROJECT=sgx-generative-adventure
# GOOGLE_CLOUD_LOCATION=us-central1

# Public client SDK config, as a single-line JSON string. Public by design.
# e.g. {"apiKey":"...","authDomain":"...","projectId":"...","storageBucket":"...","messagingSenderId":"...","appId":"..."}
PUBLIC_FIREBASE_CONFIG=

# Server-only admin credentials (service-account JSON, single line).
# Only needed for LOCAL dev — on Firebase App Hosting, Application Default
# Credentials are used automatically, so leave this blank in production.
FIREBASE_ADMIN_CREDENTIALS=

# Comma-separated allowlist of emails permitted to access the /editor.
EDITOR_ALLOWED_EMAILS=
